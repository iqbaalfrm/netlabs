# ============================================================
# NETLABS MONOREPO .gitignore
# ============================================================

# ── BACKEND ──
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.env
backend/chroma_db/

# ── WEB LARAVEL ──
web-laravel/.env
web-laravel/vendor/
web-laravel/storage/framework/cache/
web-laravel/storage/framework/sessions/
web-laravel/storage/framework/views/
web-laravel/storage/logs/
web-laravel/bootstrap/cache/

# ── MOBILE ──
mobile/.dart_tool/
mobile/.packages
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.idea/
mobile/*.iml

# ── GENERAL ──
.DS_Store
Thumbs.db
*.log
*.env
!*.env.example
.vscode/settings.json
