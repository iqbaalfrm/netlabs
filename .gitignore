# ============================================================
# NETLABS MONOREPO .gitignore
# ============================================================

# ── BACKEND ──
backend/venv/
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.env
backend/chroma_db/

# ── WEB ADMIN ──
web-admin/node_modules/
web-admin/dist/
web-admin/.env

# ── MOBILE ──
mobile/.dart_tool/
mobile/.packages
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.idea/
mobile/*.iml

# ── GENERAL ──
.DS_Store
Thumbs.db
*.log
*.env
!*.env.example
.vscode/settings.json
