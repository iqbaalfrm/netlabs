# ============================================================
# Netlabs Backend — Environment Variables
# Copy file ini ke .env lalu isi dengan nilai yang sebenarnya
# ============================================================

# Supabase (wajib)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Anthropic Claude API (wajib untuk AI Chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# JWT Secret (wajib, minimal 32 karakter)
JWT_SECRET=ganti-ini-dengan-string-acak-yang-panjang-minimal-32-karakter

# ChromaDB path (opsional, untuk RAG lokal)
CHROMA_PATH=./chroma_db

# Environment (development / production)
APP_ENV=development

# CORS origins tambahan (pisahkan dengan koma, opsional)
CORS_ORIGINS=
